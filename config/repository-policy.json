{
  "version": 1,
  "purpose": "Repository navigation/placement policy only; not runtime application configuration",
  "allowed_root_files": [
    ".dockerignore",
    ".flake8",
    ".gitattributes",
    ".gitignore",
    ".gitleaks.toml",
    ".pre-commit-config.yaml",
    "AGENTS.md",
    "Dockerfile",
    "README.md",
    "conftest.py",
    "docker-compose.staging.yml",
    "docker-compose.yml",
    "manage.py",
    "package-lock.json",
    "package.json",
    "pyproject.toml",
    "pytest.ini",
    "render.yaml",
    "render_build.sh",
    "requirements-prod.txt",
    "requirements.txt",
    "riot.txt",
    "riot_test.py",
    "schema.yml",
    "start.sh",
    "start_dev.ps1",
    "tailwind.config.js"
  ],
  "active_documents": [
    "README.md",
    "AGENTS.md",
    "docs/architecture/auth-and-permissions.md",
    "docs/architecture/data-model.md",
    "docs/architecture/overview.md",
    "docs/architecture/realtime-and-notifications.md",
    "docs/architecture/tournaments.md",
    "docs/getting-started/setup.md",
    "docs/getting-started/workflow.md",
    "docs/guides/features.md",
    "docs/guides/testing.md",
    "docs/index.md",
    "docs/operations/deployment.md",
    "docs/operations/integrations.md",
    "docs/operations/security.md",
    "docs/reference/api.md",
    "docs/reference/environment.md",
    "docs/reference/management-commands.md",
    "docs/reference/troubleshooting.md",
    "docs/runbooks/README.md",
    "docs/runbooks/media-origin-governor.md",
    "docs/runbooks/public-cdn-delivery.md",
    "docs/runbooks/public-image-derivatives.md",
    "docs/runbooks/signing-key-rotation.md",
    "Documents/Development/README.md",
    "Documents/Development/STATUS.md",
    "Documents/Development/BACKLOG.md",
    "Documents/Development/DECISIONS.md",
    "Documents/Development/HANDOFF.md"
  ],
  "historical_documents": [
    "ops/README.md",
    "tests/README.md"
  ],
  "protected_workspace_directories": [
    "Documents/DELTACROWN/",
    "Documents/",
    "docs/",
    "media/",
    "Artifacts/",
    "reports/"
  ],
  "rules": [
    "Owner-approved public exceptions: only the reviewed docs/ set and the Documents/Development files listed in active_documents and .gitignore are tracked; all other protected workspace material stays local and private.",
    "Ignored owner files are outside placement enforcement; inventory/review them separately.",
    "Never auto-delete documents, databases, media or artifacts.",
    "Do not add runtime templates, manifests or required bundles to a document archive."
  ]
}
