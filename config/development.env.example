# Blank local-only setup example. Never overwrite an existing .env.
DJANGO_SETTINGS_MODULE=deltacrown.settings
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-your-own-long-random-local-development-signing-key
DATABASE_URL=postgresql://<local-user>:<local-password>@127.0.0.1:5432/ownlobby_dev
DATABASE_URL_DEV=postgresql://<local-user>:<local-password>@127.0.0.1:5432/ownlobby_dev
DATABASE_URL_TEST=postgresql://<local-test-user>:<local-test-password>@127.0.0.1:55432/ownlobby_test
SITE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
DISABLE_INPROCESS_MATCH_REMINDER=1
ENABLE_DISCORD_BOT=0
SENTRY_DSN=
CLOUDINARY_URL=
OWNLOBBY_DOMAIN_ENABLED=0
PUBLIC_DOMAIN_REDIRECTS_ENABLED=0
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
RIOT_REDIRECT_URI=
RIOT_API_KEY=
STEAM_API_KEY=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
