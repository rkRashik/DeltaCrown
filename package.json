{
  "name": "deltacrown-frontend",
  "version": "1.0.0",
  "description": "Frontend build tools for OwnLobby tournament platform",
  "scripts": {
    "build-css": "tailwindcss -i ./static/src/input.css -o ./static/dist/tailwind.css --minify",
    "watch-css": "tailwindcss -i ./static/src/input.css -o ./static/dist/tailwind.css --watch",
    "build-community": "node scripts/build-community.cjs",
    "build": "npm run build-community && npm run build-css"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "esbuild": "0.28.2",
    "tailwindcss": "^3.4.0"
  },
  "keywords": [
    "deltacrown",
    "esports",
    "tournament",
    "tailwind"
  ],
  "author": "OwnLobby",
  "license": "Proprietary"
}
